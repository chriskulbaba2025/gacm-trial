{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/chriskulbaba2025/gacm-trial/schemas/gacm-approved-batch.schema.json",
  "title":"GACM Pre-approved Sequential Batch Envelope V1",
  "type":"object","additionalProperties":false,
  "required":["schema","batchId","project","repository","startSha","approvedBranch","model","reasoningEffort","maxExecutions","maxDurationSeconds","maxProviderSpendUsd","permitsProductionMutation","permitsPushMergeDeployPublish","permitsSubagents","tranches","approval"],
  "properties":{
    "schema":{"const":"GACM_PREAPPROVED_SEQUENTIAL_BATCH_V1"},
    "batchId":{"type":"string","pattern":"^[A-Za-z0-9._-]{3,120}$"},
    "project":{"type":"string","minLength":1},
    "repository":{"type":"string","minLength":1},
    "startSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "approvedBranch":{"type":"string","minLength":1},
    "model":{"const":"gpt-5.6-luna"},
    "reasoningEffort":{"const":"medium"},
    "maxExecutions":{"type":"integer","minimum":1,"maximum":100},
    "maxDurationSeconds":{"type":"integer","minimum":1},
    "maxProviderSpendUsd":{"const":0},
    "permitsProductionMutation":{"const":false},
    "permitsPushMergeDeployPublish":{"const":false},
    "permitsSubagents":{"const":false},
    "tranches":{"type":"array","minItems":2,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","objective","verificationContractDigest","allowedPaths","forbiddenPaths","maxAttempts"],
      "properties":{"id":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},
        "verificationContractDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "allowedPaths":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "forbiddenPaths":{"type":"array","items":{"type":"string","minLength":1}},
        "maxAttempts":{"type":"integer","minimum":1,"maximum":3}
      }
    }},
    "approval":{"type":"object","additionalProperties":false,
      "required":["approverId","authorityRecord","frozenDigest"],
      "properties":{"approverId":{"type":"string","minLength":1},"authorityRecord":{"type":"string","minLength":1},
        "frozenDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
    }
  }
}
